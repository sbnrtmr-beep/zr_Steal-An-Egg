-- دوال التفعيل والتحكم البرمجي
local currentSpeed = 16
local antiHitEnabled = false
local godConnection

-- تطبيق السرعة
SpeedBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local num = tonumber(SpeedBox.Text)
        if num then
            if num > 500 then num = 500 end
            if num < 1 then num = 1 end
            currentSpeed = num
            SpeedBox.Text = tostring(num)
        end
    end
end)

-- حلقة فرض السرعة ومنع الموت
RunService.Heartbeat:Connect(function()
    local char = player.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            -- تطبيق السرعة المستمرة إذا تجاوزت الافتراضي
            if currentSpeed ~= 16 and humanoid.MoveDirection.Magnitude > 0 then
                humanoid.WalkSpeed = currentSpeed
            end
            
            -- تفعيل منع الموت / الحماية إذا كانت مفعلة
            if antiHitEnabled and humanoid.Health < humanoid.MaxHealth then
                humanoid.Health = humanoid.MaxHealth
            end
        end
    end
end)

-- زر تبديل حماية الدم
ToggleGodBtn.MouseButton1Click:Connect(function()
    antiHitEnabled = not antiHitEnabled
    if antiHitEnabled then
        ToggleGodBtn.BackgroundColor3 = Color3.fromRGB(45, 180, 85)
        ToggleGodBtn.Text = "الحالة: شغال (ON)"
    else
        ToggleGodBtn.BackgroundColor3 = Color3.fromRGB(180, 45, 45)
        ToggleGodBtn.Text = "الحالة: مطفي (OFF)"
    end
end)

