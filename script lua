-- دوال التشغيل
local currentSpeed = 16
local antiHitEnabled = false

SpeedBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local num = tonumber(SpeedBox.Text)
        if num then
            if num > 500 then num = 500 end
            if num < 1 then num = 1 end
            currentSpeed = num
            SpeedBox.Text = tostring(num)
        end
    end
end)

-- حلقة لتطبيق السرعة وحماية الضرب
RunService.Heartbeat:Connect(function()
    local char = player.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            if currentSpeed ~= 16 and humanoid.MoveDirection.Magnitude > 0 then
                humanoid.WalkSpeed = currentSpeed
            end
        end
        
        -- ميزة حماية الضرب: تعطيل تلامس الأجزاء (CanCollide) لأدوات واسلحة الخصوم القريبة لتجنب الضربات المباشرة
        if antiHitEnabled then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    -- إلغاء تلامس أجزاء معينة إن لزم أو حماية الشخصية
                    part.CanTouch = true -- ابقاء التلامس الأساسي لتجنب الوقوع، ولكن نلغي ضرر الأسلحة عبر تعطيل التماس مع أدواتهم
                end
            end
            
            -- إلغاء تفاعل أدوات الضرب للآخرين المجاورة لشخصيتك
            for _, otherPlayer in ipairs(game.Players:GetPlayers()) do
                if otherPlayer ~= player and otherPlayer.Character then
                    local enemyTool = otherPlayer.Character:FindFirstChildOfClass("Tool")
                    if enemyTool then
                        for _, p in ipairs(enemyTool:GetDescendants()) do
                            if p:IsA("BasePart") then
                                p.CanTouch = false
                            end
                        end
                    end
                end
            end
        end
    end
end)

ToggleGodBtn.MouseButton1Click:Connect(function()
    antiHitEnabled = not antiHitEnabled
    if antiHitEnabled then
        ToggleGodBtn.BackgroundColor3 = Color3.fromRGB(45, 180, 85)
        ToggleGodBtn.Text = "الحالة: شغال (ON)"
    else
        ToggleGodBtn.BackgroundColor3 = Color3.fromRGB(180, 45, 45)
        ToggleGodBtn.Text = "الحالة: مطفي (OFF)"
    end
end)
